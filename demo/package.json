{
  "name": "knobkit-demo-video",
  "private": true,
  "description": "Remotion source for the knobkit marketing MP4 and README GIF.",
  "scripts": {
    "dev": "remotion studio",
    "render:mp4": "remotion render Demo out/demo.mp4",
    "render:gif": "ffmpeg -i out/demo.mp4 -filter_complex \"fps=12,scale=800:-2:flags=lanczos,split[s0][s1];[s0]palettegen=max_colors=256:stats_mode=diff[p];[s1][p]paletteuse=dither=sierra2_4a:diff_mode=rectangle\" -y out/demo.gif"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
